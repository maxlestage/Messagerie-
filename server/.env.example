# Domaine servi par Caddy (DNS A/AAAA -> cette machine). Obligatoire en prod.
DOMAIN=relais.example.com

# Plafond de participants par code de jumelage (optionnel, défaut 16).
MAX_PEERS=16

# --- Mises à jour push de Live Activity (APNs) — optionnel ---
# Si ces 4 variables sont absentes, l'endpoint /push/live-activity/update
# répond 503 (push désactivé). Clé APNs (.p8) créée sur developer.apple.com
# → Keys → Apple Push Notifications service (APNs).
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_KEY_ID=ABC123DEF4
# APNS_TEAM_ID=2FW8T4UX4L
# APNS_BUNDLE_ID=rs.brocolis.messagerie
# APNS_ENV=sandbox   # sandbox (builds development) ou production (TestFlight/App Store)
