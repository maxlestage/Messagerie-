<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Complète l'Info.plist généré (GENERATE_INFOPLIST_FILE) : le lien
	     brocolis://pair?code=K7P2QX, envoyé par message à quelqu'un de loin,
	     ouvre l'app directement sur l'appairage, code rempli. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>rs.brocolis.messagerie</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>brocolis</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
