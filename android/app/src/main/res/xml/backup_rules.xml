<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11 (si allowBackup venait à être réactivé) : le trousseau
     Brocolis et le reste des données de l'app sont exclus de la sauvegarde. -->
<full-backup-content>
    <exclude domain="sharedpref" path="group.rs.brocolis.messagerie.xml" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
