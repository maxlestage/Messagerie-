<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : rien du trousseau Brocolis ne part, ni dans la sauvegarde
     cloud, ni lors d'un transfert d'appareil à appareil. Les secrets y sont de
     toute façon chiffrés par une clé Keystore qui ne quitte pas ce téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="group.rs.brocolis.messagerie.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <!-- Le v3 (appareil, sessions à double cliquet) : no_backup/BrocolisV3,
             jamais sauvegardé ni transféré (docs/SECURITE.md §8.1). -->
        <exclude domain="root" path="no_backup/BrocolisV3/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="group.rs.brocolis.messagerie.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <!-- Le v3 (appareil, sessions à double cliquet) : no_backup/BrocolisV3,
             jamais sauvegardé ni transféré (docs/SECURITE.md §8.1). -->
        <exclude domain="root" path="no_backup/BrocolisV3/" />
    </device-transfer>
</data-extraction-rules>
