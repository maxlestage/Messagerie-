{
  "expo": {
    "name": "Messagerie 🥦",
    "slug": "messagerie-brocolis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "messagerie",
    "splash": {
      "backgroundColor": "#4a9e4a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "rs.brocolis.messagerie"
    },
    "android": {
      "package": "rs.brocolis.messagerie"
    },
    "plugins": ["expo-secure-store"]
  }
}
